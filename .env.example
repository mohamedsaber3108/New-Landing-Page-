# Environment variable NAMES used by this site. No values here, ever.
#
# The app runs on Miniflare (`wrangler dev`), which does NOT read .env or the
# systemd environment. Put real values in a KEY=VALUE file at:
#   1. the path in $USAM_DEV_VARS_FILE, or
#   2. ~/.usam/dev.vars          (server, recommended), or
#   3. ./.dev.vars               (local development; gitignored)
# `npm start` copies it to dist/server/.dev.vars (scripts/stage-dev-vars.mjs).
# Never commit that file, and never paste values in chat or tickets.

# --- App settings (read at runtime) ---

# Admin token for every /api/v1/admin/* route. Unset = admin disabled (403).
# Rule: random (e.g. `openssl rand -hex 32`), 32+ characters, rotated when
# staff with access change.
USAM_ADMIN_TOKEN=

# Staff MFA (L-A1b). Key for the AES-GCM encryption of TOTP secrets and the
# backup-code hashes. Random, 32+ characters (e.g. `openssl rand -hex 32`).
# Unset = MFA set-up and sign-in for MFA accounts are refused (503), so
# super_admin and admin cannot sign in fully. Changing it voids every enrolled
# secret and backup code (staff must enrol again).
USAM_MFA_ENCRYPTION_KEY=

# Admin audit log (L-A2). HMAC key of the audit hash chain and the signed
# daily export. Random, 32+ characters (e.g. `openssl rand -hex 32`).
# Unset = no audit entries are written and sensitive admin actions (policy
# publish, new MFA backup codes) are refused (503); reads still work.
# Never change it once rows exist: old rows would no longer verify.
USAM_AUDIT_HMAC_KEY=

# Optional. Webhook URL for lead-notification outbox events.
USAM_LEAD_NOTIFY_WEBHOOK=

# Optional. Marks an email notification channel (provider wiring is a gated task).
USAM_LEAD_NOTIFY_EMAIL=

# Optional. Public origin for sitemap/robots. Default: https://usamif.com
USAM_SITE_URL=

# Optional, lands with the rate limits (PR #7). Set to 1 ONLY if the origin accepts
# traffic from Cloudflare alone; then CF-Connecting-IP is trusted as client IP.
# Unset = ignore that header and use X-Real-IP / last X-Forwarded-For.
USAM_TRUST_CF_CONNECTING_IP=

# --- Launcher setting (read by scripts/stage-dev-vars.mjs, not by the app) ---

# Optional. Path of the KEY=VALUE secrets file to stage (overrides the defaults
# above). Set it in the shell or service environment, NOT in the dev.vars file,
# so it is a comment here:
# USAM_DEV_VARS_FILE=

# --- Not env variables ---
# DB: the D1 database is a binding named `DB` (see .openai/hosting.json), not a variable.
#
# Tooling names set by the scripts themselves; do not set by hand:
#   SITES_RUNTIME_ROOT, SITES_INSTALL_REPORT_PATH, CLOUDFLARE_CF_FETCH_ENABLED,
#   WRANGLER_SEND_METRICS, WRANGLER_WRITE_LOGS, WRANGLER_LOG_PATH,
#   WRANGLER_REGISTRY_PATH, MINIFLARE_REGISTRY_PATH, SHARP_IGNORE_GLOBAL_LIBVIPS,
#   CODEX_SANDBOX.
# CI only (scripts/axe-ci.mjs): AXE_BASE_URL, AXE_REPORT_ONLY.
# Acceptance script only (docs/acceptance/acceptance-browser-checks.cjs):
#   USAM_BASE (target site, default https://usamif.com).
